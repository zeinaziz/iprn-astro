---
interface Props { lines: string[] }
const { lines } = Astro.props;
---
<section class="hero">
  <div class="container inner">
    <h1 class="h1">
      {lines.map((l, i) => <>{l}{i < lines.length - 1 && <br />}</>)}
    </h1>
    <img class="art" src="/assets/hero-lines.svg" alt="" width="455" height="304" />
  </div>
</section>

<style>
  .hero { overflow: hidden; }
  .inner {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 386px;
  }
  h1 { flex: 1; min-width: 0; }
  .art { flex-shrink: 0; width: 455.378px; height: 304px; }

  @media (max-width: 1024px) {
    .art { width: 340px; height: auto; }
  }
  @media (max-width: 767px) {
    .inner { flex-direction: column; align-items: flex-start; gap: 32px; min-height: 0; padding-block: 48px; }
    .art { width: 100%; max-width: 455px; height: auto; }
  }
</style>

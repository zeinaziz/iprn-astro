---
import { url } from "../lib/url";
import { recentUpdate } from "../data/site";
---
<section class="recent">
  <div class="container inner">
    <h2 class="h2">Recent Update</h2>
    <div class="item">
      <h3 class="h4">{recentUpdate.title}</h3>
      <a class="link h6" href={url(recentUpdate.href)}>
        Learn more
        <img src={url("/assets/icons/arrow-right-white.svg")} alt="" width="16" height="24" />
      </a>
    </div>
  </div>
</section>

<style>
  .recent { background: var(--c-blue); color: var(--c-white); padding-block: 60px; }
  .inner { display: grid; grid-template-columns: 1fr 1px 1fr; gap: 40px; }
  .inner::before {
    content: ""; grid-column: 2; grid-row: 1; background: var(--c-white); width: 1px;
  }
  h2 { grid-column: 1; grid-row: 1; }
  .item { grid-column: 3; grid-row: 1; display: flex; flex-direction: column; gap: 20px; min-height: 114px; justify-content: center; }
  .link { display: inline-flex; align-items: center; gap: 10px; padding-top: 5px; padding-bottom: 4px; align-self: flex-start; border-bottom: 1px solid transparent; }
  .link:hover { border-bottom-color: var(--c-white); }

  @media (max-width: 767px) {
    .inner { grid-template-columns: 1fr; gap: 24px; }
    .inner::before { display: none; }
    h2, .item { grid-column: 1; grid-row: auto; }
    .item { min-height: 0; padding-top: 24px; border-top: 1px solid var(--c-white); }
  }
</style>

---
import { Image } from "astro:assets";
import { partnerNetworks, stewardshipCouncil, type Partner } from "../data/partners";

const groups: { label: string; items: Partner[] }[] = [
  { label: "Partner networks and associations", items: partnerNetworks },
  { label: "Stewardship Council", items: stewardshipCouncil },
];
---
<section class="partners">
  <div class="wrap">
    <h2 class="h2">150+ organizations piloting the Reporting Norms</h2>
    {groups.map((g) => (
      <>
        <hr />
        <div class="group">
          <h3 class="eyebrow">{g.label}</h3>
          <ul class="logos">
            {g.items.map((p) => (
              <li>
                <Image
                  src={p.logo}
                  alt={p.name}
                  width={p.w}
                  height={p.h}
                  widths={[p.w, p.w * 2]}
                  sizes={`${p.w}px`}
                  style={`width:${p.w}px;height:${p.h}px`}
                />
              </li>
            ))}
          </ul>
        </div>
      </>
    ))}
  </div>
</section>

<style>
  .partners { padding-block: var(--section-y); }
  .wrap {
    max-width: 1600px; margin-inline: auto; padding-inline: 100px;
    display: flex; flex-direction: column; align-items: center; gap: 60px;
  }
  h2 { text-align: center; max-width: 548px; }
  hr { width: 100%; height: 1px; border: 0; background: var(--c-beige); margin: 0; }
  .group { display: flex; flex-direction: column; align-items: center; gap: 60px; width: 100%; }
  .logos {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center;
    gap: 60px; max-width: 1166px;
  }
  .logos li { width: 185px; height: 115px; display: grid; place-items: center; }
  .logos img { object-fit: contain; max-width: 100%; }

  @media (max-width: 1024px) {
    .wrap { padding-inline: var(--gutter); gap: 48px; }
    .group { gap: 40px; }
    .logos { gap: 32px 40px; }
  }
  @media (max-width: 767px) {
    .logos { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; width: 100%; }
    .logos li { width: 100%; height: 90px; }
    .logos li:last-child:nth-child(odd) { grid-column: span 2; }
    .logos img { max-height: 80px; width: auto !important; height: auto !important; max-width: 150px; }
  }
</style>

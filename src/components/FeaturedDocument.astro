---
import { url } from "../lib/url";
import { Image } from "astro:assets";
import cover from "../assets/norms-cover.png";

interface Props { title: string; href: string; }
const { title, href } = Astro.props;
---
<section class="featured">
  <div class="container">
    <div class="inner">
      <p class="p-xl lead"><slot /></p>
      <a class="card" href={url(href)}>
        <Image src={cover} alt="" width={550} height={239} widths={[550, 1100]} sizes="(max-width: 767px) 100vw, 550px" class="cover" />
        <div class="body">
          <span class="eyebrow">Document</span>
          <h3 class="h4">{title}</h3>
        </div>
        <div class="action">
          <span class="h6">Read more</span>
          <span class="btn"><img src={url("/assets/icons/download.svg")} alt="" width="24" height="24" /></span>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .inner {
    display: flex; gap: 80px; align-items: flex-start;
    padding-block: var(--section-y);
    border-top: 1px solid var(--c-beige);
  }
  .lead { flex: 1; min-width: 0; }
  .card {
    width: 550px; flex-shrink: 0;
    background: var(--c-white); border-radius: var(--radius); overflow: hidden;
    box-shadow: var(--shadow-card);
    display: flex; flex-direction: column;
    transition: box-shadow .2s;
  }
  .card:hover { box-shadow: 0 0 28px rgba(0, 0, 0, 0.16); }
  .cover { width: 100%; height: 239px; object-fit: cover; }
  .body { padding: 40px 30px; display: flex; flex-direction: column; gap: 20px; }
  .eyebrow { color: var(--c-blue); }
  .action { display: flex; height: 60px; }
  .action .h6 { flex: 1; background: var(--c-beige); display: flex; align-items: center; padding-inline: 30px; }
  .btn { width: 60px; background: var(--c-blue); display: grid; place-items: center; transition: background .2s; }
  .card:hover .btn { background: var(--c-dark-blue); }

  @media (max-width: 1024px) {
    .inner { gap: 40px; }
    .card { width: 45%; }
  }
  @media (max-width: 767px) {
    .inner { flex-direction: column; }
    .card { width: 100%; }
    .cover { height: auto; aspect-ratio: 550 / 239; }
  }
</style>
